# ============================================================================
# Supabase — usado solo por Inventario, conexión directa sin n8n de
# intermediario. Ver db/SUPABASE_CONNECTION.md para más detalle.
# El CRM (Contactos) no usa Supabase — sus contactos vienen de la
# sincronización con la API de WhatsApp, ver la sección más abajo.
#
# Mientras estas dos no estén configuradas, Inventario usa
# automáticamente su modo demo (datos en memoria) — no hace falta nada
# más para seguir trabajando en el front sin credenciales todavía.
# ============================================================================

# Server-only — NUNCA agregues el prefijo NEXT_PUBLIC_ a esta variable.
# Settings → API → "Project URL" en tu proyecto de Supabase.
# SUPABASE_URL=https://tu-proyecto.supabase.co

# Server-only — NUNCA agregues el prefijo NEXT_PUBLIC_ a esta variable.
# Tiene permisos completos y bypassa RLS; si llegara al navegador,
# cualquiera podría leer/escribir tu base de datos sin restricción.
# Settings → API → "service_role" (sección "Project API keys").
# SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Estas mismas dos variables alimentan también el login del sistema
# (Supabase Auth, ver proxy.ts) — sin ellas configuradas, la app bloquea
# el acceso a todo el mundo (falla cerrado), no deja pasar a nadie. Las
# cuentas se crean con `node scripts/manage-users.mjs create <email>
# <asesor|admin>`, no hay pantalla de registro.

# Necesaria para que las Server Components llamen a nuestras rutas
# internas con una URL absoluta. En producción (Vercel), pon la URL
# pública real de tu app.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================================
# Chatwoot — integración de la API de WhatsApp Business (self-hosted).
# Alimenta tanto el Chat como el CRM (los contactos se sincronizan desde
# acá automáticamente). Mientras estas tres no estén configuradas, ambos
# usan su modo demo (datos en memoria).
# ============================================================================

# URL de tu instancia de Chatwoot (ej: https://chatwoot.tudominio.com).
# CHATWOOT_URL=https://chatwoot.tudominio.com

# API Access Token — Settings → Account → API → Generate token.
# CHATWOOT_API_TOKEN=tu-api-token

# Account ID — aparece en la URL del panel: /app/accounts/{ID}/...
# CHATWOOT_ACCOUNT_ID=1

# Solo para scripts/manage-chatwoot-agents.mjs (crear agentes/asesores sin
# depender de correo de confirmación) — NO la usa la app en tiempo de
# ejecución. Se genera en /super_admin → Platform Apps. Un Platform App
# nuevo solo puede administrar cuentas que él mismo creó; para vincularlo
# a una cuenta ya existente hace falta correr un comando de consola de
# Rails una sola vez (ver conversación / historial de este proyecto).
# CHATWOOT_PLATFORM_TOKEN=tu-platform-app-token
